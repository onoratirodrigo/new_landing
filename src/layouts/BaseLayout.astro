---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /**
   * La página monta <IntroStencil />. Hace falta declararlo acá y no
   * resolverlo dentro del componente porque el header tiene que estar oculto
   * desde el primer paint: si la clase la pusiera un script del <body>, el
   * navbar alcanza a dibujarse antes y se ve un parpadeo al recargar.
   */
  intro?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = "Etman es la distribuidora mayorista de autopartes con mayor cobertura nacional de Argentina. Más de 65 años de trayectoria al servicio del Aftermarket.",
  intro = false,
} = Astro.props;

// Sólo la home tiene la sección "Etman Market" contra la que corre el
// degradé de scroll bordeaux -> magenta (ver el script inline más abajo y
// Header.astro). En cualquier otra página bajo BaseLayout (ej. /login)
// no tiene sentido arrancar en bordeaux si no hay a dónde "llegar".
const isHome = Astro.url.pathname === "/";

// Ver dónde se usa, más abajo en el <head>.
const introHeaderCss = "html.intro-running #site-header{opacity:0;pointer-events:none}";
---

<!doctype html>
<html
  lang="es"
  data-home={isHome ? "true" : "false"}
  class={intro ? "intro-running" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E91E63" />
    <link rel="icon" type="image/png" href="/images/favicon-etman.png" />
    <link rel="apple-touch-icon" href="/images/favicon-etman.png" />
    <link rel="shortcut icon" href="/images/favicon-etman.png" />
    <title>{title}</title>
    {
      /* Va inline en el <head> y no en el CSS de IntroStencil a propósito: el
         de un componente es una hoja aparte que puede llegar después del
         primer paint (en dev la inyecta el cliente de Vite), y entonces el
         navbar se ve un instante antes de ocultarse. IntroStencil lo vuelve a
         mostrar con un style inline cuando el logo aterriza.

         El CSS va por set:html porque dentro de una expresión Astro leería
         las llaves del bloque CSS como código; y con is:inline el contenido
         es texto crudo, así que un template literal se imprimiría literal. */
      intro && <style is:inline set:html={introHeaderCss} />
    }
    <script is:inline>
      // En la home, el sitio arranca en bordeaux y va virando a magenta a
      // medida que se scrollea, hasta llegar a "Etman Market" (ver detalle
      // en Header.astro, que toma el control apenas el DOM está listo).
      // Como toda carga de página arranca con scroll en el tope, el estado
      // inicial correcto es bordeaux puro: lo aplicamos acá mismo para
      // evitar el flash inverso (magenta -> bordeaux).
      (function () {
        try {
          var root = document.documentElement;
          var prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;

          // Sin la intro (movimiento reducido) el navbar tiene que estar
          // visible desde el arranque: se saca la clase acá, antes del primer
          // paint, para que no llegue a verse oculto.
          if (prefersReducedMotion) root.classList.remove("intro-running");

          var startsInBordeaux = !prefersReducedMotion && root.dataset.home === "true";

          if (startsInBordeaux) {
            var BORDEAUX = {
              "50": "252 233 238",
              "100": "248 211 221",
              "200": "242 166 186",
              "300": "233 109 142",
              "400": "223 42 90",
              "500": "114 17 43",
              "600": "98 15 37",
              "700": "71 11 27",
              "800": "44 7 17",
              "900": "27 4 10",
            };
            for (var k in BORDEAUX) {
              root.style.setProperty("--brand-" + k, BORDEAUX[k]);
            }
          }

          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute("content", startsInBordeaux ? "#72112B" : "#E91E63");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-white text-ink-900 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-white focus:text-brand-600 focus:px-4 focus:py-2 focus:rounded-full focus:shadow"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    <script>
      import { initScrollReveal } from "../scripts/scrollReveal";

      initScrollReveal();

      // Botones magnéticos: en desktop (mouse fino) y sin preferencia de
      // reducir movimiento, los botones ".btn" siguen levemente al cursor
      // cuando se acercan, y vuelven a su lugar al alejarse.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      const hasFinePointer = window.matchMedia("(pointer: fine)").matches;

      if (!prefersReducedMotion && hasFinePointer) {
        const STRENGTH = 0.35;
        const MAX_OFFSET = 10;

        document.querySelectorAll<HTMLElement>(".btn").forEach((btn) => {
          btn.addEventListener("mousemove", (e) => {
            const rect = btn.getBoundingClientRect();
            const dx = e.clientX - (rect.left + rect.width / 2);
            const dy = e.clientY - (rect.top + rect.height / 2);
            const offsetX = Math.max(-MAX_OFFSET, Math.min(MAX_OFFSET, dx * STRENGTH));
            const offsetY = Math.max(-MAX_OFFSET, Math.min(MAX_OFFSET, dy * STRENGTH));
            btn.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
          });
          btn.addEventListener("mouseleave", () => {
            btn.style.transform = "";
          });
        });
      }
    </script>
  </body>
</html>
