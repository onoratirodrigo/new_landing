---
// Sección destacada: el nuevo Etman Market.
//
// La sección se reparte una pantalla completa: cabecera centrada arriba,
// un toggle de dos vistas en el medio y el CTA cerrando. Los tamaños de
// texto y el de las maquetas están atados también al alto del viewport,
// así en pantallas bajas se comprime todo en vez de desbordar.
//
// Dos formas de mostrar el Market, como en Sucursales (dos botones para
// pasar de una a la otra):
//
//   1. "Demo en vivo": una reconstrucción FIEL del Market que recorre el
//      flujo real de compra en loop (barra rosa + patente -> resuelve el
//      vehículo -> 4 cards iguales a las del sitio -> stock por sucursal ->
//      agrega al carrito -> desliza al carrito -> finaliza -> confirmación).
//      Datos reales de catálogo (public/images/market-demo/); precios y
//      stock de ejemplo. Motor en scripts/marketDemo.ts.
//
//   2. "Capturas": el carrusel con paralaje de las capturas del Market.
//      Portado del pen "Parallax Carousel — No Libraries" de MOZZARELLA
//      (https://codepen.io/TheMOZZARELLA/pen/QwyQGaG). Comportamiento en
//      scripts/marketCarousel.ts; imágenes generadas por `npm run images`.
//
// La microinteracción del CTA vive en scripts/marketCta.ts.
import {
  demoBusqueda,
  demoResultados,
  demoCarrito,
  metodosEntrega,
  STOCK_LABEL,
} from "../data/marketDemo";
import { marketSlides, MARKET_WIDTHS } from "../data/marketSlides";

const srcset = (slug: string, ext: "avif" | "webp") =>
  MARKET_WIDTHS.map((w) => `/images/etman-market/${slug}-${w}.${ext} ${w}w`).join(", ");

// Describe el ancho del <img>, que es un 114% del de la slide por el
// sobrante que necesita el recorrido del paralaje (ver .em-shot).
const SIZES = "(max-width: 720px) 105vw, min(89vw, 87vh)";
---

<section id="etman-market" class="em-section">
  {/* Wrapper con position:relative propio: si esto va directo en el
      <section>, compite con el canvas del ShimmerGrid en el mismo nivel de
      apilado y lo tapa. El posicionamiento va en .em-stack. Ver
      ShimmerGrid.astro. */}
  <div class="em-stack">
    <div class="container-x em-head" data-reveal="up">
      <span class="em-badge">
        <i></i>Nuevo · Plataforma B2B
      </span>

      <h2 class="em-title">Conocé el nuevo Etman Market.</h2>

      <p class="em-lead">
        Un e-commerce mayorista pensado para acelerar tu negocio: catálogo completo
        en línea, búsqueda por patente y por código, condiciones comerciales
        personalizadas y todo el stock de Etman en un solo lugar.
      </p>

      <ul class="em-features">
        <li class="em-feature">
          <span class="em-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="10.5" cy="10.5" r="6.5" stroke-width="1.6" data-anim="found"></circle>
              <g data-anim="lens">
                <circle cx="10.5" cy="10.5" r="6.5"></circle>
                <line x1="15.3" y1="15.3" x2="20.5" y2="20.5"></line>
              </g>
            </svg>
          </span>
          <div>
            <h3>Búsqueda inteligente</h3>
            <p>Por patente, por código o por sistema del vehículo.</p>
          </div>
        </li>

        <li class="em-feature">
          <span class="em-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 12 L15.4 13.6" data-anim="hour"></path>
              <path d="M12 12 L12 6.6" data-anim="minute"></path>
            </svg>
          </span>
          <div>
            <h3>Pedidos 24/7</h3>
            <p>Comprá, presupuestá y gestioná tus devoluciones cuando quieras.</p>
          </div>
        </li>

        <li class="em-feature">
          <span class="em-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <g data-anim="pct">
                <line x1="18.6" y1="5.4" x2="5.4" y2="18.6"></line>
                <circle cx="7.6" cy="7.6" r="2.6"></circle>
                <circle cx="16.4" cy="16.4" r="2.6"></circle>
              </g>
            </svg>
          </span>
          <div>
            <h3>Condiciones del mes</h3>
            <p>Promociones, lanzamientos y outlet siempre actualizados.</p>
          </div>
        </li>

        <li class="em-feature">
          <span class="em-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="20.4" rx="4.2" ry="1.5" stroke-width="1.6" data-anim="ripple"></ellipse>
              <g data-anim="pin">
                <path d="M12 19.4s6.4-5 6.4-9.8a6.4 6.4 0 1 0-12.8 0c0 4.8 6.4 9.8 6.4 9.8Z"></path>
                <circle cx="12" cy="9.6" r="2.3"></circle>
              </g>
            </svg>
          </span>
          <div>
            <h3>Tu sucursal, tu stock</h3>
            <p>Visibilidad por punto logístico para una entrega más rápida.</p>
          </div>
        </li>
      </ul>
    </div>

    {/* Toggle de dos vistas + las dos maquetas */}
    <div class="em-switch" data-reveal="up">
      <div class="em-viewtabs" role="group" aria-label="Cómo querés ver el Etman Market">
        <button type="button" class="em-viewtab is-active" data-view-btn="shots" aria-pressed="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><circle cx="8.5" cy="9" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
          Capturas
        </button>
        <button type="button" class="em-viewtab" data-view-btn="live" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          Demo en vivo
        </button>
      </div>

      {/* --- Vista 2: demo en vivo --- */}
      <div class="em-view" data-view="live" hidden>
        <div class="em-demo" id="market-demo" data-screen="0">
          <div class="mk">
            {/* Cromo del navegador */}
            <div class="mk-chrome">
              <span class="mk-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="mk-addr">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="5" y="11" width="14" height="9" rx="2"></rect>
                  <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
                </svg>
                market.etman.com.ar
              </span>
              <span class="mk-sample">datos de ejemplo</span>
            </div>

            {/* Header blanco del Market, con el logo real */}
            <div class="mk-top">
              <img class="mk-logo" src="/images/market-demo/logo-etman-market.png" alt="Etman Market" width="140" height="35" />
              <span class="mk-top-fill"></span>
              <span class="mk-user">Sea bienvenido</span>
              <span class="mk-cart">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="9" cy="20" r="1.4"></circle>
                  <circle cx="17" cy="20" r="1.4"></circle>
                  <path d="M2.5 3h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8a1.5 1.5 0 0 0 1.5-1.2L21 6H6"></path>
                </svg>
                Mi carrito
                <span class="mk-cart-n" aria-hidden="true">1</span>
              </span>
            </div>

            {/* Barra rosa de búsqueda */}
            <div class="mk-search">
              <span class="mk-quick">Búsqueda rápida
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
              <div class="mk-patente">
                <span class="mk-typed" data-typed></span><span class="mk-caret" aria-hidden="true"></span>
                <svg class="mk-patente-ico" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle><line x1="16" y1="16" x2="21" y2="21"></line>
                </svg>
              </div>
              <span class="mk-nav">Vehículos</span>
              <span class="mk-nav">Sistema</span>
              <span class="mk-nav">Código</span>
              <span class="mk-nav-fill"></span>
              <span class="mk-nav mk-nav--alt">Lanzamientos</span>
              <span class="mk-nav mk-nav--alt">Destacados</span>
              <span class="mk-nav mk-nav--alt">Promociones</span>
            </div>

            {/* Escenario que desliza entre las tres pantallas del flujo */}
            <div class="mk-stage">
              <div class="mk-track">
                {/* --- Pantalla 1: búsqueda + resultados --- */}
                <div class="mk-screen mk-screen--buscar">
                  <div class="mk-resolved">
                    <span class="mk-rlabel">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16" y1="16" x2="21" y2="21"></line></svg>
                      Resultados para
                    </span>
                    <span class="mk-field" data-chip><small>Automotriz</small>{demoBusqueda.vehiculo.automotriz}</span>
                    <span class="mk-field" data-chip><small>Modelo</small>{demoBusqueda.vehiculo.modelo}</span>
                    <span class="mk-field" data-chip><small>Motor</small>{demoBusqueda.vehiculo.motor}</span>
                    <span class="mk-field mk-field--pieza"><small>Pieza</small><span data-pieza></span><span class="mk-caret mk-caret--pieza" aria-hidden="true"></span></span>
                  </div>

                  <ul class="mk-grid">
                    {demoResultados.map((p, i) => (
                      <li class="mk-prod" data-card style={`--i:${i}`}>
                        <span class="mk-prod-marca"><img src={p.logo} alt={p.marca} width="46" loading="lazy" /></span>
                        <span class="mk-prod-img"><img src={p.img} alt={p.nombre} width="176" height="176" loading="lazy" /></span>
                        <span class="mk-prod-titulo">{p.nombre}</span>
                        <span class="mk-prod-ref"><small>Marca:</small> {p.marca}</span>
                        <span class="mk-prod-ref"><small>Código:</small> {p.codigo}</span>
                        <span class="mk-prod-preco">{p.precio}</span>
                        <div class="mk-prod-estoque">
                          <span class="mk-estoque-btn">Ver Disponibilidad</span>
                          <span class="mk-estoque-badge" data-stock={p.stock}><i aria-hidden="true"></i>{STOCK_LABEL[p.stock]}</span>
                        </div>
                        <div class="mk-prod-info">
                          <span class="mk-infobtn">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><polyline points="14 3 14 8 19 8"></polyline></svg>
                            Ficha técnica
                          </span>
                          <span class="mk-infobtn">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="7" x2="20" y2="7"></line><line x1="8" y1="12" x2="20" y2="12"></line><line x1="8" y1="17" x2="20" y2="17"></line><circle cx="4" cy="7" r="1"></circle><circle cx="4" cy="12" r="1"></circle><circle cx="4" cy="17" r="1"></circle></svg>
                            Aplicaciones
                          </span>
                        </div>
                        <div class="mk-prod-acoes">
                          <span class="mk-qtd" aria-hidden="true"><b>–</b><em>1</em><b>+</b></span>
                          <span class="mk-comprar">
                            <span class="mk-comprar-idle">Agregar al carrito</span>
                            <span class="mk-comprar-done">Agregado&nbsp;✓</span>
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* --- Pantalla 2: carrito --- */}
                <div class="mk-screen mk-screen--carrito">
                  <h4 class="mk-cart-titulo mk-cart-titulo--center">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    Carrito de compras
                  </h4>
                  <div class="mk-cart-dia">Entrega en el día</div>
                  <div class="mk-cart-table">
                    <div class="mk-crow mk-crow--cart mk-crow--head">
                      <span>Producto</span><span>Marca</span><span>Código</span><span>Precio Etman</span><span>Precio de costo</span><span>Cantidad</span><span>Eliminar</span>
                    </div>
                    {demoCarrito.items.map((it) => (
                      <div class="mk-crow mk-crow--cart">
                        <span class="mk-cprod">
                          <img src={it.img} alt={it.nombre} width="34" height="34" loading="lazy" />
                          <span class="mk-cprod-txt"><b>{it.nombre}</b></span>
                        </span>
                        <span class="mk-cmarca">{it.marca}</span>
                        <span class="mk-ccod">{it.codigo}</span>
                        <span class="mk-cpre">{it.precio}</span>
                        <span class="mk-ccosto"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M6 3h12l3 5-9 13L3 8z"></path></svg>{it.costo}</span>
                        <span class="mk-cqtd"><b>–</b><em>{it.cantidad}</em><b>+</b></span>
                        <span class="mk-cdel" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </span>
                      </div>
                    ))}
                  </div>
                  <div class="mk-cart-sumario">
                    <span>Cantidad de productos en el carrito: <b>{demoCarrito.cantidadTotal}</b></span>
                    <span>Precio total de Etman: <b>{demoCarrito.totalEtman}</b></span>
                  </div>
                  <div class="mk-cart-foot">
                    <span class="mk-btn-ghost">‹ Regresar a las compras</span>
                    <span class="mk-cart-actions">
                      <span class="mk-btn-soft">Generar presupuesto</span>
                      <span class="mk-realizar">Realizar pedido</span>
                    </span>
                  </div>
                </div>

                {/* --- Pantalla 3: información del pedido (resumen de envío) --- */}
                <div class="mk-screen mk-screen--pedido">
                  <h4 class="mk-cart-titulo mk-cart-titulo--center">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    Información del pedido
                  </h4>
                  <div class="mk-ped">
                    <div class="mk-ped-main">
                      <div class="mk-cart-dia">Entrega en el día</div>
                      <div class="mk-cart-table">
                        <div class="mk-crow mk-crow--ped mk-crow--head">
                          <span>Producto</span><span>Precio de costo</span><span>Cantidad</span><span>Total</span><span>Método de entrega</span><span></span>
                        </div>
                        {demoCarrito.items.map((it) => (
                          <div class="mk-crow mk-crow--ped">
                            <span class="mk-cprod">
                              <img src={it.img} alt={it.nombre} width="30" height="30" loading="lazy" />
                              <span class="mk-cprod-txt"><b>{it.nombre}</b><small>{it.marca} · {it.codigo}</small></span>
                            </span>
                            <span class="mk-ccosto"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M6 3h12l3 5-9 13L3 8z"></path></svg>{it.costo}</span>
                            <span class="mk-cqtd"><b>–</b><em>{it.cantidad}</em><b>+</b></span>
                            <span class="mk-csub">{it.subtotal}</span>
                            <span class="mk-cmet">
                              <span class="mk-cmet-sel">Seleccione</span>
                              <span class="mk-cmet-done">{demoCarrito.entregaElegida}</span>
                            </span>
                            <span class="mk-cdel" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="mk-ped-side">
                      <span class="mk-btn-ghost mk-btn-ghost--block">‹ Regresar a las compras</span>
                      <div class="mk-resumen">
                        <span class="mk-resumen-h">
                          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><polyline points="14 3 14 8 19 8"></polyline></svg>
                          Resumen del pedido
                        </span>
                        <span class="mk-cupon-q">¿Tienes un cupón de descuento?</span>
                        <div class="mk-cupon"><span class="mk-cupon-input"></span><span class="mk-cupon-btn">Calcular</span></div>
                        <div class="mk-resumen-line"><span>Sucursales:</span><b>{demoCarrito.sucursales}</b></div>
                        <div class="mk-resumen-line"><span>Precio total de costo:</span><b class="mk-red">{demoCarrito.totalCosto}</b></div>
                        <div class="mk-resumen-line"><span>Descuentos:</span><b>- $0</b></div>
                        <div class="mk-resumen-line mk-resumen-line--tot"><span>Total precio costo con descuentos:</span><b class="mk-red">{demoCarrito.totalCosto}</b></div>
                        <span class="mk-resumen-arts">{demoCarrito.articulos} Artículos</span>
                        <span class="mk-finalice">Finalice la compra</span>
                        <span class="mk-resumen-link">Ver campañas de descuento</span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* --- Pantalla 4: pedido confirmado --- */}
                <div class="mk-screen mk-screen--confirmado">
                  <span class="mk-done-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </span>
                  <strong class="mk-done-titulo">¡Pedido realizado!</strong>
                  <span class="mk-done-num">Pedido N° #{demoCarrito.pedido}</span>
                  <span class="mk-done-sub">Entrega en el día en tu sucursal de {demoCarrito.sucursal}. Te enviamos la confirmación por email.</span>
                </div>
              </div>
            </div>

            {/* Toast de "agregado", igual que el del Market */}
            <div class="mk-toast" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Producto agregado al carrito
            </div>

            {/* Modal de método de entrega (aparece sobre "Información del pedido") */}
            <div class="mk-modal" aria-hidden="true">
              <div class="mk-modal-box">
                <span class="mk-modal-h">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h11v11H1z"></path><path d="M12 8h5l4 4v4h-9"></path><circle cx="6" cy="18" r="1.8"></circle><circle cx="17" cy="18" r="1.8"></circle></svg>
                  Seleccioná el método de entrega
                </span>
                <div class="mk-modal-desc">
                  {metodosEntrega.map((m) => (
                    <p><b>{m.nombre}:</b> {m.desc}</p>
                  ))}
                </div>
                <ul class="mk-modal-opts">
                  {metodosEntrega.map((m) => (
                    <li class="mk-mopt"><span class="mk-mopt-radio" aria-hidden="true"></span>{m.nombre}</li>
                  ))}
                </ul>
                <label class="mk-modal-check"><span class="mk-modal-tick" aria-hidden="true"></span>Repetir la selección de transportadora para todos los pedidos.</label>
                <span class="mk-modal-confirm">Confirmar</span>
              </div>
            </div>
          </div>

          <ol class="em-steps" aria-hidden="true">
            <li class="em-step" data-step><i></i>Buscás y ves tu stock</li>
            <li class="em-step" data-step><i></i>Carrito y entrega</li>
            <li class="em-step" data-step><i></i>Pedido confirmado</li>
          </ol>
        </div>
      </div>

      {/* --- Vista 1: capturas (carrusel con paralaje) --- */}
      <div class="em-view" data-view="shots">
        <div class="em-carousel" id="market-carousel" aria-roledescription="carousel" aria-label="Capturas del nuevo Etman Market">
          <div class="em-viewport" tabindex="0">
            <div class="em-track">
              {marketSlides.map((slide, i) => (
                <article class="em-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${marketSlides.length}`}>
                  <div class="em-card">
                    <picture class="em-shot">
                      <source type="image/avif" srcset={srcset(slide.slug, "avif")} sizes={SIZES} />
                      <img
                        src={`/images/etman-market/${slide.slug}-1920.webp`}
                        srcset={srcset(slide.slug, "webp")}
                        sizes={SIZES}
                        alt={slide.alt}
                        width="1920"
                        height="1080"
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                    <div class="em-caption em-par-1">
                      <strong>{slide.title}</strong>
                      <span>{slide.kicker}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="em-controls">
            <button class="em-arrow ico-hit em-prev" type="button" aria-label="Slide anterior">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="em-arrow ico-hit em-next" type="button" aria-label="Slide siguiente">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <div class="em-footbar">
          <div class="em-dots" id="market-dots" role="tablist" aria-label="Seleccionar slide"></div>
        </div>
      </div>
    </div>

    <div class="em-cta" data-reveal="up">
      <a
        class="em-btn em-btn--solid"
        id="market-cta"
        href="https://market.etman.com.ar/login"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ingresar a Etman Market"
      >
        <span class="em-btn-track" aria-hidden="true">
          <svg class="em-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
        <span class="em-btn-label">Ingresar a Etman Market</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------
     Tokens de la sección: salen de las variables de marca, así el
     degradé de scroll del header los arrastra solo.
     --------------------------------------------------------------- */
  .em-section {
    --fg: #fff;
    --fg-soft: rgb(255 255 255 / 0.88);
    --fg-mute: rgb(255 255 255 / 0.72);
    --plate: rgb(var(--brand-800));
    --plate-strong: rgb(var(--brand-900));
    --plate-line: rgb(255 255 255 / 0.18);

    /* Geometría del carrusel de capturas. El alto sale del ancho por la
       relación de las capturas (16:9). El término en vh hace que entre en
       una pantalla junto con la cabecera. */
    --slideW: min(1040px, 76vw, 66vh);
    --slideRatio: 0.5625;
    --slidePad: clamp(10px, 1.8vh, 24px);

    /* SIN position: relative (competiría con el canvas del ShimmerGrid).
       El posicionamiento va en .em-stack. Ver ShimmerGrid.astro. */
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(18px, 3vh, 42px) 0;
    color: var(--fg);
    background: rgb(var(--brand-600));
  }

  .em-stack {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 2vh, 26px);
  }

  /* ---------------- Cabecera centrada ---------------- */

  .em-head { flex: none; text-align: center; }

  .em-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--plate);
    border: 1px solid var(--plate-line);
    padding: 6px 14px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .em-badge i { display: block; width: 6px; height: 6px; border-radius: 999px; background: var(--fg); }

  .em-title {
    font-family: theme("fontFamily.display");
    font-weight: 700;
    letter-spacing: -0.025em;
    font-size: clamp(1.45rem, min(2.7vw, 4vh), 2.5rem);
    line-height: 1.05;
    margin: clamp(9px, 1.5vh, 16px) 0 0;
    text-wrap: balance;
  }

  .em-lead {
    margin: clamp(8px, 1.2vh, 14px) auto 0;
    max-width: 76ch;
    font-size: clamp(0.84rem, min(1rem, 1.8vh), 1rem);
    line-height: 1.5;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .em-features {
    list-style: none;
    margin: clamp(12px, 1.8vh, 22px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(9px, 1.4vh, 16px) 26px;
    text-align: left;
  }
  .em-feature { display: flex; gap: 12px; align-items: flex-start; }
  .em-feature h3 {
    margin: 0 0 3px;
    font-size: clamp(0.8rem, min(0.95rem, 1.6vh), 0.95rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .em-feature p {
    margin: 0;
    font-size: clamp(0.75rem, min(0.875rem, 1.45vh), 0.875rem);
    line-height: 1.5;
    color: var(--fg-mute);
  }

  /* ---------------- Íconos con microinteracción ---------------- */

  .em-ico {
    position: relative;
    overflow: hidden;
    flex: none;
    margin-top: 1px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--plate);
    border: 1px solid var(--plate-line);
    color: var(--fg);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0, 1);
  }
  .em-feature:hover .em-ico { transform: translateY(-2px); }
  .em-ico svg { position: relative; display: block; }

  @keyframes em-sweep {
    0% { transform: translate(0, 0) rotate(0deg); }
    28% { transform: translate(-2.6px, 0.8px) rotate(-12deg); }
    62% { transform: translate(2.4px, -1px) rotate(9deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }
  @keyframes em-found {
    0% { opacity: 0; transform: scale(1); }
    45% { opacity: 0.6; }
    100% { opacity: 0; transform: scale(1.8); }
  }
  @keyframes em-tick { to { transform: rotate(360deg); } }
  @keyframes em-tock { to { transform: rotate(90deg); } }
  @keyframes em-flip { to { transform: rotate(180deg); } }
  @keyframes em-plant {
    0% { transform: translateY(-7px) scaleY(1); }
    55% { transform: translateY(0.8px) scaleY(0.88); }
    78% { transform: translateY(0) scaleY(1.05); }
    100% { transform: translateY(0) scaleY(1); }
  }
  @keyframes em-ripple {
    0% { opacity: 0; transform: scale(0.3); }
    40% { opacity: 0.7; }
    100% { opacity: 0; transform: scale(2); }
  }

  .em-feature:hover [data-anim="lens"] { animation: em-sweep 0.85s cubic-bezier(0.4, 0, 0.2, 1) 0.08s; }
  .em-feature:hover [data-anim="found"] { animation: em-found 0.5s ease-out 0.62s; }
  .em-feature:hover [data-anim="minute"] { animation: em-tick 1.15s cubic-bezier(0.5, 0, 0.2, 1) 0.08s; }
  .em-feature:hover [data-anim="hour"] { animation: em-tock 1.15s cubic-bezier(0.5, 0, 0.2, 1) 0.08s; }
  .em-feature:hover [data-anim="pct"] { animation: em-flip 0.75s cubic-bezier(0.5, 0, 0.15, 1) 0.08s; }
  .em-feature:hover [data-anim="pin"] { animation: em-plant 0.6s cubic-bezier(0.3, 0.9, 0.4, 1) 0.08s; }
  .em-feature:hover [data-anim="ripple"] { animation: em-ripple 0.55s ease-out 0.4s; }

  [data-anim="lens"] { transform-box: fill-box; transform-origin: center; }
  [data-anim="found"] { transform-box: view-box; transform-origin: 10.5px 10.5px; }
  [data-anim="minute"],
  [data-anim="hour"],
  [data-anim="pct"] { transform-box: view-box; transform-origin: 12px 12px; }
  [data-anim="pin"] { transform-box: fill-box; transform-origin: bottom center; }
  [data-anim="ripple"] { transform-box: view-box; transform-origin: 12px 20.4px; }
  [data-anim="found"],
  [data-anim="ripple"] { opacity: 0; }

  /* ================================================================
     TOGGLE de dos vistas (mismo idioma que el view-switch de Sucursales:
     píldora blanca activa, contorno translúcido inactivo).
     ================================================================ */
  .em-switch {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2vh, 22px);
  }
  .em-viewtabs {
    display: inline-flex;
    gap: 5px;
    padding: 5px;
    border-radius: 999px;
    background: var(--plate);
    border: 1px solid var(--plate-line);
  }
  .em-viewtab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-soft);
    font-family: theme("fontFamily.display");
    font-weight: 600;
    font-size: clamp(0.82rem, 1vw, 0.92rem);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .em-viewtab svg { flex: none; }
  .em-viewtab:hover { color: #fff; }
  .em-viewtab.is-active { background: #fff; color: rgb(var(--brand-700)); }
  .em-viewtab:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  .em-view {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.6vh, 18px);
  }
  /* El atributo [hidden] trae display:none del user-agent, pero la regla de
     autor de arriba (.em-view { display:flex }) le gana y lo anula. Sin
     esto, la vista "oculta" se sigue mostrando y aparecen las dos juntas. */
  .em-view[hidden] { display: none; }

  /* ================================================================
     VISTA 1 — DEMO VIVA (paleta REAL del Market, ajena al tema).
     ================================================================ */
  .em-demo {
    --winW: min(1040px, 94vw);
    --mk-pink: #f52c75;
    --mk-wine: #b3125a;
    --mk-bg: #f0f2f1;
    --mk-white: #ffffff;
    --mk-line: #e6e6e8;
    --mk-ink: #292929;
    --mk-soft: #3c3c3c;
    --mk-mute: #707070;
    --ok-fg: #1a7f47;
    --ok-bg: #e5f4ec;
    --wait-fg: #97650a;
    --wait-bg: #fbefd4;

    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.6vh, 18px);
  }

  .mk {
    position: relative;
    width: var(--winW);
    border-radius: 14px;
    overflow: hidden;
    background: var(--mk-bg);
    color: var(--mk-ink);
    font-size: clamp(12px, 1.12vw, 14px);
    box-shadow:
      0 30px 60px -24px rgb(var(--brand-900) / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .mk *, .mk *::before, .mk *::after { box-sizing: border-box; }

  /* ---- Cromo del navegador ---- */
  .mk-chrome { display: flex; align-items: center; gap: 12px; padding: 8px 13px; background: #241b2b; }
  .mk-lights { display: inline-flex; gap: 6px; flex: none; }
  .mk-lights i { width: 9px; height: 9px; border-radius: 999px; background: rgb(255 255 255 / 0.22); }
  .mk-addr {
    display: inline-flex; align-items: center; gap: 7px; flex: 1; min-width: 0;
    justify-content: center; padding: 4px 12px; border-radius: 999px;
    background: rgb(255 255 255 / 0.08); color: rgb(255 255 255 / 0.7); font-size: 0.85em;
  }
  .mk-addr svg { flex: none; opacity: 0.7; }
  .mk-sample {
    flex: none; padding: 3px 9px; border-radius: 999px;
    background: rgb(255 255 255 / 0.1); color: rgb(255 255 255 / 0.55);
    font-size: 0.72em; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  }

  /* ---- Header blanco con el logo real ---- */
  .mk-top {
    display: flex; align-items: center; gap: 10px;
    padding: 8px clamp(12px, 1.6vw, 20px);
    background: var(--mk-white); border-bottom: 1px solid var(--mk-line);
  }
  .mk-logo { height: clamp(26px, 3.4vh, 34px); width: auto; display: block; }
  .mk-top-fill { flex: 1; }
  .mk-user { color: var(--mk-mute); font-size: 0.92em; }
  .mk-cart {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    color: var(--mk-ink); font-weight: 600; font-size: 0.92em;
  }
  .mk-cart-n {
    position: absolute; top: -7px; left: 10px; min-width: 15px; height: 15px; padding: 0 3px;
    border-radius: 999px; background: var(--mk-pink); color: #fff;
    font-size: 0.62em; font-weight: 800; line-height: 15px; text-align: center;
    transform: scale(0); transition: transform 0.3s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .em-demo[data-added] .mk-cart-n { transform: scale(1); }

  /* ---- Barra rosa de búsqueda ---- */
  .mk-search {
    display: flex; align-items: center; gap: clamp(8px, 1vw, 14px);
    padding: 0 clamp(12px, 1.6vw, 20px); height: 42px;
    background: var(--mk-pink); color: #fff; white-space: nowrap;
  }
  .mk-quick { display: inline-flex; align-items: center; gap: 5px; font-weight: 600; font-size: 0.92em; flex: none; }
  .mk-patente {
    position: relative; display: flex; align-items: center; gap: 6px;
    height: 26px; min-width: 12ch; padding: 0 10px; border-radius: 6px;
    background: #fff; color: var(--mk-ink); font-weight: 600; flex: none;
  }
  .mk-patente-ico { margin-left: auto; color: var(--mk-pink); }
  .mk-nav { display: inline-flex; align-items: center; font-size: 0.9em; font-weight: 500; color: rgb(255 255 255 / 0.92); flex: none; }
  .mk-nav--alt { color: rgb(255 255 255 / 0.82); }
  .mk-nav-fill { flex: 1; min-width: 6px; }

  /* Cursor: apagar la ANIMACIÓN además del opacity (una animación pisa al
     opacity declarativo). */
  .mk-caret { display: inline-block; width: 2px; height: 1.05em; background: var(--mk-pink); animation: em-blink 1s step-end infinite; }
  .mk-caret--pieza { opacity: 0; animation: none; }
  .em-demo[data-piezalista] .mk-patente .mk-caret { opacity: 0; animation: none; }
  .em-demo[data-piezalista] .mk-caret--pieza { opacity: 1; animation: em-blink 1s step-end infinite; }
  @keyframes em-blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }

  /* ---- Escenario deslizante (4 pantallas) ---- */
  .mk-stage { overflow: hidden; }
  .mk-track { display: flex; width: 400%; transition: transform 0.6s cubic-bezier(0.65, 0, 0.2, 1); }
  .mk-screen {
    flex: 0 0 25%; width: 25%;
    padding: clamp(11px, 1.6vh, 18px) clamp(12px, 1.6vw, 20px) clamp(13px, 1.8vh, 20px);
    display: flex; flex-direction: column; gap: clamp(11px, 1.6vh, 16px);
  }
  .em-demo[data-screen="1"] .mk-track { transform: translateX(-25%); }
  .em-demo[data-screen="2"] .mk-track { transform: translateX(-50%); }
  .em-demo[data-screen="3"] .mk-track { transform: translateX(-75%); }

  /* Fila resuelta */
  .mk-resolved { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .mk-rlabel { display: inline-flex; align-items: center; gap: 6px; color: var(--mk-mute); font-weight: 600; font-size: 0.9em; }
  .mk-field {
    display: inline-flex; flex-direction: column; gap: 1px; padding: 5px 11px;
    border-radius: 7px; background: var(--mk-white); border: 1px solid var(--mk-line);
    color: var(--mk-ink); font-weight: 700; font-size: 0.92em; line-height: 1.15;
    opacity: 0; transform: translateY(5px) scale(0.96);
    transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .mk-field small { font-size: 0.62em; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--mk-mute); }
  .mk-field[data-on] { opacity: 1; transform: none; }
  .mk-field--pieza { flex: 1; min-width: 8ch; border-color: var(--mk-pink); box-shadow: 0 0 0 3px rgb(245 44 117 / 0.12); opacity: 1; transform: none; }

  /* ---- Grilla: 4 cards ---- */
  .mk-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, 0.9vw, 13px); }
  .mk-prod {
    position: relative; display: flex; flex-direction: column;
    padding: 10px; border-radius: 5px; border: 1px solid var(--mk-line); background: var(--mk-white);
    opacity: 0; transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.7, 0, 1);
    transition-delay: calc(var(--i) * 40ms);
  }
  .mk-prod[data-on] { opacity: 1; transform: none; }
  .mk-prod-marca { position: absolute; top: 6px; left: 4px; z-index: 2; }
  .mk-prod-marca img { width: clamp(38px, 4.4vw, 48px); height: auto; display: block; }
  .mk-prod-img { display: flex; align-items: center; justify-content: center; height: clamp(46px, 6vh, 66px); margin-bottom: 6px; }
  .mk-prod-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .mk-prod-titulo {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    font-weight: 500; font-size: 0.92em; line-height: 1.2; color: var(--mk-ink); margin-bottom: 4px; min-height: 2.3em;
  }
  .mk-prod-ref { font-size: 0.8em; color: var(--mk-mute); line-height: 1.4; }
  .mk-prod-ref small { color: var(--mk-soft); font-size: 1em; }
  .mk-prod-preco { margin: 5px 0; font-family: theme("fontFamily.display"); font-weight: 800; font-size: 1.08em; color: var(--mk-ink); font-variant-numeric: tabular-nums; }

  .mk-prod-estoque { position: relative; min-height: 28px; margin-bottom: 6px; }
  .mk-estoque-btn, .mk-estoque-badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px;
    border-radius: 6px; font-size: 0.78em; font-weight: 700; transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .mk-estoque-btn { border: 1px solid var(--mk-line); background: #fafafa; color: var(--mk-soft); }
  .mk-estoque-badge { position: absolute; inset: 0 auto 0 0; opacity: 0; transform: translateY(4px); }
  .mk-estoque-badge i { width: 6px; height: 6px; border-radius: 999px; background: currentColor; }
  .mk-estoque-badge[data-stock="sucursal"] { background: var(--ok-bg); color: var(--ok-fg); }
  .mk-estoque-badge[data-stock="cinco-dias"] { background: var(--wait-bg); color: var(--wait-fg); }
  .em-demo[data-avail] .mk-estoque-btn { opacity: 0; }
  .em-demo[data-avail] .mk-estoque-badge { opacity: 1; transform: none; transition-delay: calc(var(--i) * 130ms); }

  .mk-prod-info { display: flex; gap: 6px; margin-bottom: 7px; }
  .mk-infobtn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    height: 26px; padding: 0 4px; border: 1px solid var(--mk-pink); border-radius: 5px;
    background: #fff; color: var(--mk-pink); font-size: 0.72em; font-weight: 700; white-space: nowrap;
  }
  .mk-infobtn svg { flex: none; }

  .mk-prod-acoes { margin-top: auto; display: flex; align-items: center; gap: 7px; }
  .mk-qtd { display: inline-flex; align-items: center; height: 30px; border: 1px solid var(--mk-line); border-radius: 5px; overflow: hidden; flex: none; }
  .mk-qtd b { display: grid; place-items: center; width: 20px; height: 100%; background: #f7f7f7; color: var(--mk-soft); font-weight: 700; }
  .mk-qtd em { display: grid; place-items: center; width: 22px; font-style: normal; font-weight: 700; color: var(--mk-ink); }
  .mk-comprar {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; height: 30px;
    border-radius: 5px; background: var(--mk-pink); color: #fff; font-size: 0.82em; font-weight: 700; white-space: nowrap;
  }
  .mk-comprar-done { display: none; }
  .em-demo[data-added] .mk-prod:first-child .mk-comprar { background: var(--ok-fg); }
  .em-demo[data-added] .mk-prod:first-child .mk-comprar-idle { display: none; }
  .em-demo[data-added] .mk-prod:first-child .mk-comprar-done { display: inline; }

  /* ================================================================
     Carrito e "Información del pedido": tabla, resumen lateral y modal,
     calcados de las pantallas reales del Market.
     ================================================================ */
  .mk-cart-titulo { display: inline-flex; align-items: center; gap: 8px; margin: 0; font-family: theme("fontFamily.display"); font-weight: 800; font-size: 1.12em; color: var(--mk-ink); }
  .mk-cart-titulo--center { align-self: center; }
  .mk-cart-dia { color: var(--mk-soft); font-weight: 600; font-size: 0.86em; }

  .mk-cart-table { display: flex; flex-direction: column; border: 1px solid var(--mk-line); border-radius: 8px; overflow: hidden; background: #fff; }
  .mk-crow {
    align-items: center; gap: 10px; padding: 9px clamp(9px, 1.1vw, 13px);
    border-left: 3px solid var(--ok-fg); font-size: 0.88em;
  }
  .mk-crow--cart { display: grid; grid-template-columns: 2.1fr 0.9fr 0.9fr 1.1fr 1.2fr 1fr 0.6fr; }
  .mk-crow--ped { display: grid; grid-template-columns: 2.1fr 1.2fr 1fr 1.1fr 1.5fr 0.5fr; }
  .mk-crow + .mk-crow { border-top: 1px solid var(--mk-line); }
  .mk-crow--head { border-left-color: transparent; background: #fafafa; color: var(--mk-mute); font-weight: 700; font-size: 0.74em; text-transform: uppercase; letter-spacing: 0.02em; }
  .mk-cprod { display: inline-flex; align-items: center; gap: 9px; min-width: 0; }
  .mk-cprod img { width: 32px; height: 32px; object-fit: contain; border: 1px solid var(--mk-line); border-radius: 5px; padding: 2px; background: #fff; flex: none; }
  .mk-cprod-txt { display: flex; flex-direction: column; min-width: 0; }
  /* Nombre del producto en rosa, como en el carrito real. */
  .mk-cprod-txt b { font-weight: 600; color: var(--mk-pink); line-height: 1.2; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .mk-cprod-txt small { color: var(--mk-mute); font-size: 0.82em; }
  .mk-cmarca, .mk-ccod { color: var(--mk-mute); font-variant-numeric: tabular-nums; }
  .mk-cpre { color: var(--mk-pink); font-weight: 700; font-variant-numeric: tabular-nums; }
  /* Precio de costo con el diamante verde, como en el Market. */
  .mk-ccosto { display: inline-flex; align-items: center; gap: 5px; color: var(--ok-fg); font-weight: 700; font-variant-numeric: tabular-nums; }
  .mk-ccosto svg { flex: none; opacity: 0.9; }
  .mk-cqtd { display: inline-flex; align-items: center; height: 26px; width: max-content; border: 1px solid var(--mk-line); border-radius: 5px; overflow: hidden; }
  .mk-cqtd b { display: grid; place-items: center; width: 20px; height: 100%; background: #f7f7f7; color: var(--mk-soft); font-weight: 700; }
  .mk-cqtd em { display: grid; place-items: center; width: 22px; font-style: normal; font-weight: 700; }
  .mk-csub { font-weight: 800; color: var(--ok-fg); font-variant-numeric: tabular-nums; }
  .mk-cdel { color: var(--mk-pink); justify-self: center; }

  /* Celda "Método de entrega": botón "Seleccione" hasta que el modal se
     confirma; ahí muestra el método elegido. */
  .mk-cmet { display: inline-flex; }
  .mk-cmet-sel, .mk-cmet-done { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 5px; font-weight: 700; font-size: 0.92em; }
  .mk-cmet-sel { background: var(--mk-pink); color: #fff; }
  .mk-cmet-done { display: none; gap: 5px; background: var(--ok-bg); color: var(--ok-fg); }
  .em-demo[data-metodo] .mk-cmet-sel { display: none; }
  .em-demo[data-metodo] .mk-cmet-done { display: inline-flex; }

  /* Sumario del carrito (centrado, como en la captura). */
  .mk-cart-sumario { display: flex; flex-direction: column; align-items: center; gap: 2px; color: var(--mk-soft); font-size: 0.92em; }
  .mk-cart-sumario b { color: var(--mk-ink); font-weight: 800; }

  /* Botones del pie del carrito. */
  .mk-cart-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .mk-cart-actions { margin-left: auto; display: inline-flex; gap: 10px; }
  .mk-btn-ghost { display: inline-flex; align-items: center; justify-content: center; height: 34px; padding: 0 16px; border: 1px solid var(--mk-line); border-radius: 6px; color: var(--mk-soft); font-weight: 700; font-size: 0.86em; background: #fff; }
  .mk-btn-ghost--block { width: 100%; }
  .mk-btn-soft, .mk-realizar { display: inline-flex; align-items: center; justify-content: center; height: 34px; padding: 0 18px; border-radius: 6px; background: var(--mk-pink); color: #fff; font-weight: 800; font-size: 0.86em; letter-spacing: 0.01em; }
  .mk-btn-soft { background: var(--mk-wine); }
  .mk-realizar { transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .em-demo[data-realizar] .mk-realizar { transform: scale(1.05); box-shadow: 0 0 0 4px rgb(245 44 117 / 0.22); }

  /* ---- Pantalla 3: información del pedido (tabla + resumen lateral) ---- */
  .mk-screen--pedido { gap: clamp(9px, 1.3vh, 13px); }
  .mk-ped { display: grid; grid-template-columns: 1fr minmax(210px, 0.42fr); gap: clamp(10px, 1.4vw, 16px); align-items: start; }
  .mk-ped-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .mk-ped-side { display: flex; flex-direction: column; gap: 10px; }

  .mk-resumen { display: flex; flex-direction: column; gap: 9px; padding: clamp(12px, 1.6vh, 16px); border: 1px solid var(--mk-line); border-radius: 10px; background: #fff; }
  .mk-resumen-h { display: inline-flex; align-items: center; gap: 7px; font-family: theme("fontFamily.display"); font-weight: 800; font-size: 1.02em; color: var(--mk-ink); }
  .mk-cupon-q { color: var(--mk-pink); font-weight: 600; font-size: 0.84em; text-align: center; }
  .mk-cupon { display: flex; gap: 7px; }
  .mk-cupon-input { flex: 1; height: 30px; border: 1px solid var(--mk-line); border-radius: 5px; background: #fff; }
  .mk-cupon-btn { display: inline-flex; align-items: center; padding: 0 14px; border-radius: 5px; background: var(--mk-pink); color: #fff; font-weight: 700; font-size: 0.84em; }
  .mk-resumen-line { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 0.86em; color: var(--mk-soft); border-top: 1px solid var(--mk-line); padding-top: 7px; }
  .mk-resumen-line b { color: var(--mk-ink); font-weight: 700; }
  .mk-red { color: var(--mk-pink) !important; }
  .mk-resumen-line--tot { font-weight: 700; }
  .mk-resumen-arts { color: var(--mk-mute); font-size: 0.84em; }
  .mk-finalice { display: inline-flex; align-items: center; justify-content: center; height: 40px; border-radius: 6px; background: var(--mk-pink); color: #fff; font-weight: 800; font-size: 0.9em; letter-spacing: 0.02em; text-transform: uppercase; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .em-demo[data-confirm] .mk-finalice { transform: scale(1.04); box-shadow: 0 0 0 4px rgb(245 44 117 / 0.22); }
  .mk-resumen-link { color: var(--mk-pink); font-size: 0.84em; text-align: center; text-decoration: underline; }

  /* ---- Modal de método de entrega (overlay sobre la ventana) ---- */
  .mk-modal {
    position: absolute; inset: 0; z-index: 20;
    display: grid; place-items: center; padding: 16px;
    background: rgb(20 12 26 / 0.5);
    opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
  }
  .em-demo[data-modal] .mk-modal { opacity: 1; pointer-events: auto; }
  .mk-modal-box {
    width: min(440px, 92%); max-height: 92%; overflow: auto;
    display: flex; flex-direction: column; gap: 10px;
    padding: clamp(16px, 2.4vh, 24px); border-radius: 12px; background: #fff;
    box-shadow: 0 24px 60px -20px rgb(20 12 26 / 0.6);
    transform: scale(0.95); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .em-demo[data-modal] .mk-modal-box { transform: scale(1); }
  .mk-modal-h { display: inline-flex; align-items: center; gap: 9px; font-family: theme("fontFamily.display"); font-weight: 800; font-size: 1.15em; color: var(--mk-ink); }
  .mk-modal-desc { display: flex; flex-direction: column; gap: 5px; }
  .mk-modal-desc p { margin: 0; font-size: 0.85em; color: var(--mk-soft); line-height: 1.4; }
  .mk-modal-desc b { color: var(--mk-ink); font-weight: 700; }
  .mk-modal-opts { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .mk-mopt { display: inline-flex; align-items: center; gap: 9px; font-size: 0.9em; color: var(--mk-ink); }
  .mk-mopt-radio { flex: none; width: 16px; height: 16px; border-radius: 999px; border: 2px solid #c4c4c8; position: relative; transition: border-color 0.25s ease; }
  .mk-mopt-radio::after { content: ""; position: absolute; inset: 3px; border-radius: 999px; background: var(--mk-pink); transform: scale(0); transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1); }
  /* El ciclo elige la primera opción (Logística Etman). */
  .em-demo[data-optsel] .mk-mopt:first-child { font-weight: 700; }
  .em-demo[data-optsel] .mk-mopt:first-child .mk-mopt-radio { border-color: var(--mk-pink); }
  .em-demo[data-optsel] .mk-mopt:first-child .mk-mopt-radio::after { transform: scale(1); }
  .mk-modal-check { display: inline-flex; align-items: center; gap: 8px; margin-top: 2px; font-size: 0.82em; color: var(--mk-mute); }
  .mk-modal-tick { flex: none; width: 15px; height: 15px; border-radius: 3px; border: 1.5px solid #c4c4c8; }
  .mk-modal-confirm { align-self: center; margin-top: 4px; display: inline-flex; align-items: center; justify-content: center; height: 38px; padding: 0 36px; border-radius: 6px; background: var(--mk-pink); color: #fff; font-weight: 800; }

  /* ---- Pantalla 4: pedido confirmado ---- */
  .mk-screen--confirmado { align-items: center; justify-content: center; text-align: center; gap: 8px; }
  .mk-done-check { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 999px; background: var(--ok-bg); color: var(--ok-fg); margin-bottom: 4px; }
  .mk-done-titulo { font-family: theme("fontFamily.display"); font-weight: 800; font-size: 1.35em; color: var(--mk-ink); }
  .mk-done-num { font-weight: 700; color: var(--ok-fg); }
  .mk-done-sub { max-width: 42ch; color: var(--mk-mute); font-size: 0.92em; line-height: 1.5; }

  /* ---- Toast ---- */
  .mk-toast {
    position: absolute; right: clamp(12px, 1.6vw, 20px); bottom: clamp(12px, 1.6vh, 18px);
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 8px;
    background: #1f6b3d; color: #fff; font-weight: 700; font-size: 0.88em;
    box-shadow: 0 12px 26px -10px rgb(20 60 35 / 0.6);
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0, 1); pointer-events: none;
  }
  .em-demo[data-added][data-screen="0"] .mk-toast { opacity: 1; transform: none; }

  /* Apagado antes de reiniciar el loop. */
  .em-demo[data-fade] .mk-prod,
  .em-demo[data-fade] .mk-field[data-chip],
  .em-demo[data-fade] .mk-cart-n {
    opacity: 0; transition: opacity 0.44s ease; transition-delay: 0s;
  }

  /* ---------------- Indicador de pasos ---------------- */
  .em-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(10px, 2vw, 26px); }
  .em-step { display: inline-flex; align-items: center; gap: 7px; font-size: clamp(0.72rem, 1vw, 0.82rem); font-weight: 600; color: var(--fg-mute); transition: color 0.3s ease; }
  .em-step i { width: 8px; height: 8px; border-radius: 999px; background: rgb(255 255 255 / 0.3); transition: background 0.3s ease, transform 0.3s cubic-bezier(0.3, 1.3, 0.5, 1); }
  .em-step[data-on] { color: var(--fg); }
  .em-step[data-on] i { background: var(--fg); transform: scale(1.3); }

  /* ================================================================
     VISTA 2 — CARRUSEL DE CAPTURAS (con paralaje).
     Portado del pen de MOZZARELLA. Ver scripts/marketCarousel.ts.
     ================================================================ */
  .em-carousel { position: relative; flex: none; width: 100%; overflow: hidden; contain: layout paint; }
  .em-viewport { position: relative; outline: none; overflow: hidden; touch-action: pan-y; }
  .em-viewport:focus-visible { outline: 2px solid var(--fg); outline-offset: -6px; border-radius: 8px; }
  .em-track {
    position: relative;
    height: calc(var(--slideW) * var(--slideRatio) + var(--slidePad) * 2);
    transform-style: preserve-3d; perspective: 1400px; overflow: hidden;
  }
  /* Centrado por márgenes automáticos (no translate -50%): el layout se
     redondea a píxel entero al pintar, un transform no. */
  .em-slide {
    position: absolute; top: 0; bottom: 0; left: 50%;
    margin-top: auto; margin-bottom: auto; margin-left: calc(var(--slideW) / -2);
    width: var(--slideW); height: calc(var(--slideW) * var(--slideRatio));
    border-radius: 18px; overflow: hidden;
  }
  .em-carousel[data-moving] .em-slide { will-change: transform, filter; }
  .em-card {
    position: relative; width: 100%; height: 100%; border-radius: inherit; overflow: hidden;
    background: var(--plate); box-shadow: 0 20px 50px rgb(var(--brand-900) / 0.45); cursor: grab;
  }
  .em-card:active { cursor: grabbing; }
  /* La captura se declara grande (114% vía inset) y sólo se traslada, para
     que el navegador la rasterice al tamaño real en vez de estirar. */
  .em-shot {
    position: absolute; inset: -7%; display: block;
    transform: translate3d(var(--parBgX, 0px), var(--parBgY, 0px), 0);
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .em-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .em-card::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(var(--brand-900) / 0.16) 0%, rgb(var(--brand-900) / 0.08) 42%, rgb(14 14 15 / 0.58) 100%);
    transition: opacity 800ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .em-slide[data-state="active"] .em-card::after { opacity: 0.72; }
  .em-slide[data-state="active"] .em-card { box-shadow: 0 34px 70px rgb(var(--brand-900) / 0.6), 0 0 0 1px rgb(255 255 255 / 0.12) inset; }
  .em-caption { position: absolute; inset: auto 16px 13px 16px; z-index: 2; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .em-caption strong { font-family: theme("fontFamily.display"); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(0.95rem, min(1.5vw, 2.3vh), 1.3rem); text-shadow: 0 2px 14px rgb(14 14 15 / 0.7); }
  .em-caption span { font-size: 0.8rem; font-weight: 500; color: rgb(var(--brand-200)); text-shadow: 0 2px 12px rgb(14 14 15 / 0.7); }
  .em-par-1 { will-change: transform; transition: transform 500ms cubic-bezier(0.2, 0.7, 0, 1); transform: translate3d(calc(var(--parX, 0px) * 0.32), calc(var(--parY, 0px) * 0.32), 0); }
  .em-controls { position: absolute; inset: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 max(14px, 2vw); pointer-events: none; }
  .em-arrow {
    pointer-events: auto; width: 38px; height: 38px; border-radius: 999px;
    border: 1px solid var(--plate-line); background: var(--plate); color: var(--fg);
    display: grid; place-items: center; cursor: pointer; transition: background 0.2s ease, transform 0.2s ease;
  }
  .em-arrow:hover { background: var(--plate-strong); border-color: rgb(255 255 255 / 0.4); }
  .em-arrow:active { transform: scale(0.96); }
  .em-arrow:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .em-footbar { flex: none; display: flex; justify-content: center; }
  .em-dots { display: flex; gap: 9px; align-items: center; }
  .em-dots :global(.em-dot) { width: 9px; height: 9px; border-radius: 999px; background: rgb(255 255 255 / 0.3); border: 0; padding: 0; cursor: pointer; transition: transform 0.2s ease, background 0.2s ease; }
  .em-dots :global(.em-dot:hover) { background: rgb(255 255 255 / 0.55); }
  .em-dots :global(.em-dot[aria-selected="true"]) { background: var(--fg); transform: scale(1.35); }
  .em-dots :global(.em-dot:focus-visible) { outline: 2px solid var(--fg); outline-offset: 3px; }

  /* ---------------- CTA ---------------- */
  .em-cta { flex: none; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 0 24px; }
  .em-btn {
    display: inline-flex; align-items: center; gap: 8px; border-radius: 10px; padding: 0.6rem 1.15rem;
    font-size: 0.92rem; font-weight: 600; text-decoration: none; border: 1px solid transparent;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .em-btn:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .em-btn--solid {
    position: relative; overflow: hidden; background: var(--plate); color: var(--fg);
    border-color: var(--plate-line); box-shadow: 0 12px 28px -12px rgb(var(--brand-900));
    padding-left: 34px; padding-right: 34px;
    transition: transform 0.18s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .em-btn--solid:hover, .em-btn--solid:focus-visible {
    background: var(--plate-strong); border-color: rgb(255 255 255 / 0.28);
    transform: translateY(-1px); box-shadow: 0 16px 32px -12px rgb(var(--brand-900));
  }
  .em-btn-track { position: absolute; inset: 0 11px; pointer-events: none; }
  .em-btn-arrow { position: absolute; z-index: 1; top: calc(50% - 7px); left: 0; width: 14px; height: 14px; }
  .em-btn--solid:not([data-js]) .em-btn-arrow { transition: left 0.8s linear; }
  .em-btn--solid:not([data-js]):hover .em-btn-arrow,
  .em-btn--solid:not([data-js]):focus-visible .em-btn-arrow { left: calc(100% - 14px); }
  .em-btn-label { position: relative; z-index: 2; white-space: pre; }

  /* ---------------- Responsive ---------------- */
  @media (max-width: 1100px) {
    .em-section { --slideW: min(880px, 84vw, 58vh); }
    .em-features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .mk-nav, .mk-nav--alt, .mk-nav-fill { display: none; }
    .mk-search { justify-content: flex-start; }
  }
  @media (max-width: 720px) {
    .em-section { --slideW: min(92vw, 46vh); }
    .em-demo { --winW: min(96vw, 460px); }
    .em-features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; max-width: 440px; margin-inline: auto; }
    .em-feature p { display: none; }
    .mk-user { display: none; }
    .mk-grid { gap: 8px; }
    .mk-prod-info { flex-direction: column; }
    /* Carrito: quedan Producto · Precio Etman · Cantidad · Eliminar. */
    .mk-crow--cart { grid-template-columns: 2fr 1.1fr 1fr 0.5fr; }
    .mk-crow--cart > :nth-child(2),
    .mk-crow--cart > :nth-child(3),
    .mk-crow--cart > :nth-child(5) { display: none; }
    /* Info del pedido: apila tabla y resumen; quedan Producto · Cantidad ·
       Método · Eliminar. */
    .mk-ped { grid-template-columns: 1fr; }
    .mk-crow--ped { grid-template-columns: 2fr 1fr 1.5fr 0.5fr; }
    .mk-crow--ped > :nth-child(2),
    .mk-crow--ped > :nth-child(4) { display: none; }
    .mk-cart-actions { margin-left: 0; width: 100%; }
    .mk-btn-soft, .mk-realizar { flex: 1; }
    .em-arrow { width: 34px; height: 34px; }
    .em-caption span { display: none; }
  }
  @media (max-height: 640px) { .em-lead { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .mk-track { transition: none !important; }
    .mk-field, .mk-prod, .mk-caret, .mk-cart-n, .mk-estoque-btn, .mk-estoque-badge, .mk-toast,
    .mk-realizar, .mk-finalice, .mk-modal, .mk-modal-box, .mk-mopt-radio, .em-step i {
      transition: none !important; animation: none !important;
    }
    .mk-caret { opacity: 0; }
    .em-demo[data-avail] .mk-estoque-badge { transition-delay: 0s; }
    .em-shot, .em-par-1 { transition: none; }
    .em-feature:hover [data-anim] { animation: none; }
    .em-feature:hover .em-ico { transform: none; }
    .em-btn-arrow { transition: none; }
  }
</style>

<script>
  import { initMarketDemo } from "../scripts/marketDemo";
  import { initMarketCarousel } from "../scripts/marketCarousel";
  import { initMarketCta } from "../scripts/marketCta";

  // Demo en vivo (arranca/pausa sola según viewport y visibilidad).
  const demo = document.getElementById("market-demo");
  if (demo) initMarketDemo(demo);

  // Toggle entre las dos vistas. Arranca en "Capturas", así que el carrusel se
  // inicializa de entrada: medir un carrusel oculto (display:none) da tamaños
  // en cero y rompe el layout de las slides.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"));
  const views = Array.from(document.querySelectorAll<HTMLElement>(".em-view"));
  let carouselReady = false;

  const prepararCarrusel = () => {
    if (carouselReady) return;
    carouselReady = true;
    const carousel = document.getElementById("market-carousel");
    const dots = document.getElementById("market-dots");
    if (carousel && dots) initMarketCarousel(carousel, dots);
  };

  const mostrar = (name: string) => {
    tabs.forEach((b) => {
      const on = b.dataset.viewBtn === name;
      b.classList.toggle("is-active", on);
      b.setAttribute("aria-pressed", String(on));
    });
    views.forEach((v) => {
      v.hidden = v.dataset.view !== name;
    });
    if (name === "shots") requestAnimationFrame(prepararCarrusel);
  };
  tabs.forEach((b) => b.addEventListener("click", () => mostrar(b.dataset.viewBtn || "shots")));
  prepararCarrusel();

  const cta = document.getElementById("market-cta");
  if (cta) initMarketCta(cta);
</script>
