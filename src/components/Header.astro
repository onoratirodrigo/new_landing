---
import { mainNav } from "../data/nav";

// Los links de sección (#nosotros, #contacto, etc.) sólo funcionan como anclas
// en la home. Desde cualquier otra página, hay que ir primero a "/" y recién
// ahí saltar a la sección.
const isHome = Astro.url.pathname === "/";
function resolveHref(href: string) {
  return href.startsWith("#") && !isHome ? `/${href}` : href;
}
---

<header
  id="site-header"
  data-home={isHome ? "true" : "false"}
  class={`site-header fixed top-0 inset-x-0 z-40 w-full ${isHome ? "" : "is-scrolled"}`}
>
  <div class="container-x flex h-16 md:h-20 items-center justify-between gap-6">
    {/* Logo. Usa mask-image con color via CSS var: blanco cuando el header
        es transparente, magenta cuando hace scroll. */}
    <a href="/" aria-label="Etman — Inicio" class="inline-flex items-center">
      <span
        role="img"
        aria-label="Etman"
        class="logo-mark block h-10 md:h-12 w-[110px] md:w-[130px]"
      ></span>
    </a>

    {/* La barrita que corre entre ítems vive dentro del <nav> y se posiciona
        con offsetLeft/offsetWidth del link activo (ver el script). */}
    <nav aria-label="Menú principal" class="header-nav hidden lg:flex items-center gap-1">
      <span class="nav-indicator" aria-hidden="true"></span>
      {
        mainNav.map((item) => (
          <a
            href={resolveHref(item.href)}
            data-nav-link
            data-section={item.href.startsWith("#") ? item.href.slice(1) : undefined}
            class="header-link relative px-3 py-2 rounded-full text-sm font-medium transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a href="/login" class="header-link text-sm font-medium px-3 py-2 rounded-full transition-colors">
        Ingresar
      </a>
      <a href={resolveHref("#contacto")} class="btn btn-primary text-sm">
        Quiero ser cliente
      </a>
    </div>

    {/* Toggle mobile */}
    <button
      id="nav-toggle"
      type="button"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="header-toggle ico-hit lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-full border transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="20"
        height="20"
        aria-hidden="true"
        data-ico="menu"
      >
        <line x1="3" y1="12" x2="21" y2="12" data-ico-part="mid"></line>
        <line x1="3" y1="6" x2="21" y2="6" data-ico-part="top"></line>
        <line x1="3" y1="18" x2="21" y2="18" data-ico-part="bottom"></line>
      </svg>
    </button>
  </div>

  {/* Mobile nav */}
  <div id="mobile-nav" class="lg:hidden hidden border-t border-ink-100 bg-white">
    <div class="container-x py-4 flex flex-col gap-1">
      {
        mainNav.map((item) => (
          <a
            href={resolveHref(item.href)}
            data-nav-link
            data-section={item.href.startsWith("#") ? item.href.slice(1) : undefined}
            class="mobile-nav-link px-3 py-3 rounded-lg text-base font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-600 transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/login" class="px-3 py-3 rounded-lg text-base font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-600 transition-colors">
        Ingresar
      </a>
      <a href={resolveHref("#contacto")} class="btn btn-primary mt-3 justify-center">
        Quiero ser cliente
      </a>
    </div>
  </div>
</header>

{/* Spacer no necesario: el hero usa min-h-screen y arranca debajo del header */}

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");

  // Scroll: alternar la clase .is-scrolled para opacar el header.
  // Fuera de la home el header ya arranca opaco (fondo blanco), así que no
  // tiene sentido este toggle: dejarlo activo lo volvería a poner transparente.
  const isHome = header?.dataset.home === "true";
  if (header && isHome) {
    // Con la intro del estarcido delante (IntroStencil.astro), el contenido
    // real no arranca en el tope de la página: el umbral se corre para que el
    // header siga transparente durante toda la intro y recién se opaque
    // después. Sin esto el navbar ya llega blanco al final de la intro, y el
    // traspaso del logo del estarcido al del header (que es blanco sobre el
    // bordeaux) se rompe. Si no hay intro (o está desactivada por movimiento
    // reducido), el offsetHeight es 0 y el umbral vuelve a ser el de siempre.
    const introSpace = document.querySelector<HTMLElement>(".intro-space");
    const update = () => {
      const introOffset = introSpace ? introSpace.offsetHeight : 0;
      if (window.scrollY > introOffset + 32) {
        header.classList.add("is-scrolled");
      } else {
        header.classList.remove("is-scrolled");
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  // Paletas fijas para el degradé de scroll: arranca en bordeaux y va
  // virando a magenta a medida que se acerca a "Etman Market". Como todo
  // (fondos, texto, bordes, degradés, SVGs) lee su color final de las
  // variables --brand-XXX, interpolarlas anima absolutamente todo a la vez
  // sin depender de "transition" en CSS (que no funciona con backgrounds
  // tipo gradiente).
  const BRAND_KEYS = ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900"];

  const BORDEAUX: Record<string, number[]> = {
    "50": [252, 233, 238],
    "100": [248, 211, 221],
    "200": [242, 166, 186],
    "300": [233, 109, 142],
    "400": [223, 42, 90],
    "500": [114, 17, 43],
    "600": [98, 15, 37],
    "700": [71, 11, 27],
    "800": [44, 7, 17],
    "900": [27, 4, 10],
  };
  const MAGENTA: Record<string, number[]> = {
    "50": [255, 241, 246],
    "100": [254, 224, 236],
    "200": [252, 192, 216],
    "300": [248, 139, 181],
    "400": [242, 80, 144],
    "500": [233, 30, 99],
    "600": [216, 27, 96],
    "700": [176, 18, 74],
    "800": [131, 16, 56],
    "900": [90, 10, 38],
  };

  function toHex(rgb: number[]) {
    return "#" + rgb.map((v) => v.toString(16).padStart(2, "0")).join("");
  }

  function writeBrandVars(vars: Record<string, number[]>) {
    for (const k of BRAND_KEYS) {
      document.documentElement.style.setProperty(`--brand-${k}`, vars[k].join(" "));
    }
  }

  // Degradé de scroll (bordeaux -> magenta): sólo en la home. Ver la
  // contraparte que evita el flash inicial en BaseLayout.astro.
  //
  // Arranca en bordeaux puro y no se mueve ni un poco hasta que "Nosotros"
  // llega justo al tope de la pantalla (antes de eso, en Hero/Stats, se ve
  // siempre el bordeaux completo). De ahí en adelante interpola hacia
  // magenta a medida que se acerca a "Etman Market", donde ya queda fijo
  // en magenta puro.
  const nosotrosEl = document.getElementById("nosotros");
  const etmanMarketEl = document.getElementById("etman-market");
  const prefersReducedMotionScroll = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const canRunScrollGradient =
    !prefersReducedMotionScroll && nosotrosEl !== null && etmanMarketEl !== null;
  let scrollTicking = false;

  function applyScrollGradient() {
    if (!nosotrosEl || !etmanMarketEl) return;
    const start = nosotrosEl.offsetTop;
    const end = etmanMarketEl.offsetTop;
    const span = end - start;
    const t = span > 0 ? Math.min(1, Math.max(0, (window.scrollY - start) / span)) : 1;
    const frame: Record<string, number[]> = {};
    for (const k of BRAND_KEYS) {
      frame[k] = BORDEAUX[k].map((v, i) => Math.round(v + (MAGENTA[k][i] - v) * t));
    }
    writeBrandVars(frame);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", toHex(frame["500"]));
  }

  function onScrollGradient() {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      applyScrollGradient();
      scrollTicking = false;
    });
  }

  if (canRunScrollGradient) {
    applyScrollGradient();
    window.addEventListener("scroll", onScrollGradient, { passive: true });
  }

  // =========================================================
  // Indicador del navbar: barrita que se desliza al ítem de la sección en la
  // que está parado el scroll (y al que se clickea), con un pelín de rebote.
  //
  // Se calcula con offsetLeft/offsetWidth en vez de un layout animado porque
  // los links son inline-flex de ancho variable: medir es lo único que
  // sobrevive a cambios de copy, de fuente y de zoom.
  // =========================================================
  const nav = document.querySelector<HTMLElement>(".header-nav");
  const indicator = nav?.querySelector<HTMLElement>(".nav-indicator") ?? null;
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")
  );
  const desktopLinks = navLinks.filter((a) => a.closest(".header-nav"));

  // Las secciones que el indicador puede seguir, en el orden en que aparecen
  // en la página (no en el que están en el menú, por las dudas).
  const sections = navLinks
    .map((a) => a.dataset.section)
    .filter((id, i, arr): id is string => Boolean(id) && arr.indexOf(id) === i)
    .map((id) => ({ id, el: document.getElementById(id) }))
    .filter((s): s is { id: string; el: HTMLElement } => s.el !== null)
    .sort(
      (a, b) =>
        a.el.getBoundingClientRect().top - b.el.getBoundingClientRect().top
    );

  // Cuánto se mete la barrita para adentro de cada link: los links tienen
  // px-3 (12px), así que con este inset la barra mide exactamente el texto.
  const INDICATOR_INSET = 12;
  let activeSection: string | null = null;

  function placeIndicator(link: HTMLElement | null) {
    if (!indicator) return;
    if (!link) {
      indicator.classList.remove("is-visible");
      return;
    }
    const width = Math.max(0, link.offsetWidth - INDICATOR_INSET * 2);
    indicator.style.width = `${width}px`;
    indicator.style.transform = `translateX(${link.offsetLeft + INDICATOR_INSET}px)`;
    // La primera vez aparece sin animar el desplazamiento: si no, la barra
    // entra volando desde el borde izquierdo del menú.
    if (!indicator.classList.contains("is-visible")) {
      indicator.classList.add("is-placed");
      requestAnimationFrame(() => indicator.classList.add("is-visible"));
      requestAnimationFrame(() =>
        requestAnimationFrame(() => indicator.classList.remove("is-placed"))
      );
    }
  }

  function activeLink() {
    return desktopLinks.find((a) => a.dataset.section === activeSection) ?? null;
  }

  function setActiveSection(id: string | null) {
    if (id === activeSection) return;
    activeSection = id;
    navLinks.forEach((a) => {
      const on = Boolean(id) && a.dataset.section === id;
      a.classList.toggle("is-active", on);
      if (on) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
    placeIndicator(activeLink());
  }

  function sectionInView(): string | null {
    if (sections.length === 0) return null;
    // La línea de prueba va justo debajo del header fijo: la sección activa es
    // la última que ya la cruzó. Se mide con getBoundingClientRect y no con
    // offsetTop porque las secciones cuelgan del wrapper del ShimmerGrid y
    // offsetTop es relativo al offsetParent, no al documento.
    const probe = (header?.offsetHeight ?? 0) + 24;
    let current: string | null = null;
    for (const s of sections) {
      if (s.el.getBoundingClientRect().top <= probe) current = s.id;
    }
    // Al fondo de la página la última sección puede no llegar a cruzar el
    // punto de prueba (si es más corta que el viewport): se fuerza igual.
    const atBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 4;
    if (atBottom) current = sections[sections.length - 1].id;
    return current;
  }

  if (nav && indicator && sections.length > 0) {
    let navTicking = false;
    const syncNav = () => {
      if (navTicking) return;
      navTicking = true;
      requestAnimationFrame(() => {
        setActiveSection(sectionInView());
        navTicking = false;
      });
    };

    syncNav();
    window.addEventListener("scroll", syncNav, { passive: true });

    // Al clickear, el indicador salta ya mismo en vez de esperar a que el
    // scroll suave llegue: si no, el click se siente sin respuesta.
    desktopLinks.forEach((a) => {
      a.addEventListener("click", () => {
        if (a.dataset.section) setActiveSection(a.dataset.section);
      });
    });

    // El ancho de los links cambia con el viewport (y con la fuente cuando
    // termina de cargar), así que la barra se vuelve a medir.
    const remeasure = () => placeIndicator(activeLink());
    new ResizeObserver(remeasure).observe(nav);
    window.addEventListener("resize", remeasure);
    if ("fonts" in document) {
      (document as any).fonts.ready.then(remeasure);
    }
  }

  // Toggle del menú mobile
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(isOpen));
      btn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });
    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
