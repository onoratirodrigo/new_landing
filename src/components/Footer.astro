---
import Logo from "./Logo.astro";
import { mainNav } from "../data/nav";
import { branches } from "../data/branches";
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-ink-100 mt-24">
  <div class="container-x py-16 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5 space-y-5">
      <Logo variant="light" />
      <p class="max-w-md text-ink-300 leading-relaxed">
        Brindamos la mejor cobertura, llegando a todo el país con el portafolio
        de marcas y productos más amplio del mercado de autopartes. La
        innovación es parte de nuestro ADN.
      </p>
      <div class="flex items-center gap-3">
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener"
          class="h-9 w-9 rounded-full border border-white/20 inline-flex items-center justify-center hover:bg-brand-500 hover:border-brand-500 transition-colors"
          aria-label="Instagram"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener"
          class="h-9 w-9 rounded-full border border-white/20 inline-flex items-center justify-center hover:bg-brand-500 hover:border-brand-500 transition-colors"
          aria-label="Facebook"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener"
          class="h-9 w-9 rounded-full border border-white/20 inline-flex items-center justify-center hover:bg-brand-500 hover:border-brand-500 transition-colors"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a
          href={site.social.youtube}
          target="_blank"
          rel="noopener"
          class="h-9 w-9 rounded-full border border-white/20 inline-flex items-center justify-center hover:bg-brand-500 hover:border-brand-500 transition-colors"
          aria-label="YouTube"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
          </svg>
        </a>
      </div>
    </div>

    <div class="md:col-span-3">
      <h4 class="text-sm font-semibold uppercase tracking-widest text-ink-300 mb-4">
        Compañía
      </h4>
      <ul class="space-y-2.5">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-100 hover:text-brand-500 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4">
      <h4 class="text-sm font-semibold uppercase tracking-widest text-ink-300 mb-4">
        Sucursales
      </h4>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-ink-100">
        {branches.map((b) => <li>{b.city}</li>)}
      </ul>

      <div class="mt-6 space-y-1.5 text-sm text-ink-300">
        <div>Atención comercial</div>
        <a href={site.phoneHref} class="block text-white font-semibold text-lg hover:text-brand-500 transition-colors">
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="hover:text-brand-500 transition-colors">{site.email}</a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x py-6 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-ink-300">
      <div>© {year} Grupo Etman · Todos los derechos reservados</div>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
