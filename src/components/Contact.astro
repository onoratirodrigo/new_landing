---
import { site } from "../data/site";
---

<section id="contacto" class="py-20 md:py-28 bg-brand-600">
  <div class="container-x relative z-10 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5">
      <div data-reveal="up">
        <span class="eyebrow">Contacto</span>
        <h2 class="section-title mt-4">Hablemos de tu próximo paso.</h2>
        <p class="lead mt-5">
          ¿Querés ser cliente Etman, sumarte como proveedor o necesitás una
          consulta comercial? Completá el formulario y un representante se
          comunica con vos a la brevedad.
        </p>
      </div>

      <div class="mt-8 space-y-5">
        <div class="flex items-start gap-4" data-reveal="up">
          <div class="h-10 w-10 rounded-xl bg-white/15 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Atención comercial</div>
            <a href={site.phoneHref} class="font-display font-bold text-lg text-white hover:text-white/80 transition-colors">
              {site.phone}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4" data-reveal="up" style="transition-delay: 80ms">
          <div class="h-10 w-10 rounded-xl bg-white/15 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Email</div>
            <a href={`mailto:${site.email}`} class="font-display font-bold text-lg text-white hover:text-white/80 transition-colors">
              {site.email}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4" data-reveal="up" style="transition-delay: 160ms">
          <div class="h-10 w-10 rounded-xl bg-white/15 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Cobertura</div>
            <div class="font-display font-bold text-lg text-white">
              7 sucursales en todo el país
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <form
        data-reveal="from-right"
        class="rounded-3xl bg-white border border-ink-100 p-6 md:p-8 shadow-soft space-y-5"
        method="post"
        action="#"
        novalidate
      >
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-ink-700">Nombre y apellido</span>
            <input
              type="text"
              name="nombre"
              required
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
              placeholder="Tu nombre"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink-700">Empresa</span>
            <input
              type="text"
              name="empresa"
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
              placeholder="Razón social"
            />
          </label>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-ink-700">Email</span>
            <input
              type="email"
              name="email"
              required
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
              placeholder="tu@email.com"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink-700">Teléfono</span>
            <input
              type="tel"
              name="telefono"
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
              placeholder="+54 ..."
            />
          </label>
        </div>

        <label class="block">
          <span class="text-sm font-medium text-ink-700">Tipo de consulta</span>
          <select
            name="tipo"
            class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
          >
            <option>Quiero ser cliente Etman</option>
            <option>Soy cliente Etman</option>
            <option>Quiero ser proveedor</option>
            <option>Otra consulta</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-medium text-ink-700">Mensaje</span>
          <textarea
            name="mensaje"
            rows="4"
            class="mt-1.5 w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition"
            placeholder="Contanos en qué podemos ayudarte"
          ></textarea>
        </label>

        <div class="flex items-center justify-between gap-4 pt-2">
          <p class="text-xs text-ink-400 max-w-xs">
            Al enviar aceptás nuestra política de privacidad.
          </p>
          <button type="submit" class="btn btn-primary">
            Enviar consulta
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
