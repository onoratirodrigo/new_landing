---
import { site } from "../data/site";
---

<section id="contacto" class="py-20 md:py-28 bg-brand-600">
  <div class="container-x relative z-10 grid lg:grid-cols-12 gap-12 lg:items-center">
    <div class="lg:col-span-4">
      <div data-reveal="up">
        <span class="eyebrow">Contacto</span>
        <h2 class="section-title mt-4">Hablemos de tu próximo paso.</h2>
        <p class="lead mt-5">
          ¿Querés ser cliente Etman, sumarte como proveedor o necesitás una
          consulta comercial? Completá el formulario y un representante se
          comunica con vos a la brevedad.
        </p>
      </div>

      <div class="mt-8 space-y-5">
        <div class="flex items-start gap-4 ico-hit" data-reveal="up">
          <div class="h-10 w-10 rounded-xl bg-brand-800 border border-white/20 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-ico="phone">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Atención comercial</div>
            <a href={site.phoneHref} class="font-display font-bold text-lg text-white hover:text-white/80 transition-colors">
              {site.phone}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4 ico-hit" data-reveal="up" style="transition-delay: 80ms">
          <div class="h-10 w-10 rounded-xl bg-brand-800 border border-white/20 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-ico="mail">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6" data-ico-part="flap"></polyline>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Email</div>
            <a href={`mailto:${site.email}`} class="font-display font-bold text-lg text-white hover:text-white/80 transition-colors">
              {site.email}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4 ico-hit" data-reveal="up" style="transition-delay: 160ms">
          <div class="h-10 w-10 rounded-xl bg-brand-800 border border-white/20 text-white flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-ico="pin">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/70">Cobertura</div>
            <div class="font-display font-bold text-lg text-white">
              7 sucursales en todo el país
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-8">
      {/* El formulario no va en una placa rectangular: lo sostienen dos
          burbujas orgánicas que laten (ver scripts/contactBlob.ts). La de
          atrás asoma por detrás de la de adelante, que es la que recorta
          el panel. El padding porcentual del escenario deja el aire
          necesario para que, aun en el radio mínimo, el contorno no
          alcance a los campos. */}
      <div class="ct-stage" data-reveal="from-right">
        <svg class="ct-blob" data-blob-svg aria-hidden="true">
          <defs>
            <clipPath id="contacto-blob-mask">
              <path data-blob-front></path>
            </clipPath>
          </defs>
          <path class="ct-back" data-blob-back></path>
        </svg>
        <div class="ct-face" data-blob-face></div>

        <form
          class="ct-form"
          method="post"
          action="#"
          novalidate
        >
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium text-white">Nombre y apellido</span>
              <input
                type="text"
                name="nombre"
                required
                class="plate-field mt-1.5"
                placeholder="Tu nombre"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-white">Empresa</span>
              <input
                type="text"
                name="empresa"
                class="plate-field mt-1.5"
                placeholder="Razón social"
              />
            </label>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium text-white">Email</span>
              <input
                type="email"
                name="email"
                required
                class="plate-field mt-1.5"
                placeholder="tu@email.com"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-white">Teléfono</span>
              <input
                type="tel"
                name="telefono"
                class="plate-field mt-1.5"
                placeholder="+54 ..."
              />
            </label>
          </div>

          <label class="block">
            <span class="text-sm font-medium text-white">Tipo de consulta</span>
            <select
              name="tipo"
              class="plate-field mt-1.5"
            >
              <option>Quiero ser cliente Etman</option>
              <option>Soy cliente Etman</option>
              <option>Quiero ser proveedor</option>
              <option>Otra consulta</option>
            </select>
          </label>

          <label class="block">
            <span class="text-sm font-medium text-white">Mensaje</span>
            <textarea
              name="mensaje"
              rows="3"
              class="plate-field mt-1.5"
              placeholder="Contanos en qué podemos ayudarte"
            ></textarea>
          </label>

          <div class="flex items-center justify-between gap-4 pt-2">
            <p class="text-xs text-white/60 max-w-xs">
              Al enviar aceptás nuestra política de privacidad.
            </p>
            {/* Blanco sólido y no btn-primary: el magenta de marca sobre la
                burbuja, que es del mismo palo, no se despega. */}
            <button type="submit" class="btn ico-hit bg-white text-brand-600 hover:bg-brand-50">
              Enviar consulta
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-ico="arrow">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     Escenario de las dos burbujas
     =========================================================
     La geometría (radios, segmentos, tiempos) vive en el script; acá sólo
     el lugar que ocupan y de qué color son. Los rellenos son opacos y
     salen de las variables de marca, así acompañan el cambio a Modo
     Clásico igual que el resto de la franja: la de atrás un tono más
     clara que el fondo de la sección, la de adelante bien oscura para que
     los campos y el texto blanco despeguen. */
  /* El escenario se pasa de ancho a propósito (ver abajo); la sección se
     encarga de cortar lo que sobra para que no aparezca scroll horizontal. */
  #contacto {
    overflow-x: clip;
  }

  .ct-stage {
    position: relative;
    display: grid;
    place-items: center;
    /* Porcentajes (los verticales también se miden contra el ancho): el
       aire escala con el panel y los campos nunca quedan al borde del
       contorno, ni en el momento más angosto del latido.

       Cuánto aire hace falta no es al ojo: con el radio mínimo (0.75 del
       semieje) la zona garantizada adentro del contorno es una elipse de
       semiejes 0.375 del ancho y del alto, así que el formulario entra
       mientras (u/0.375)² + (v/0.375)² ≤ 1, donde u y v son su medio
       ancho y medio alto en fracción del escenario. Con 24% de aire
       lateral u queda en 0.26, y de ahí sale el 22% de arriba y abajo. */
    padding: 22% 24%;
  }

  .ct-blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .ct-back {
    fill: rgb(var(--brand-400));
  }

  /* La burbuja de adelante no se pinta: recorta este div, que es el panel
     donde se apoya el formulario. */
  .ct-face {
    position: absolute;
    inset: 0;
    background: rgb(var(--brand-700));
    -webkit-clip-path: url(#contacto-blob-mask);
    clip-path: url(#contacto-blob-mask);
  }

  /* El formulario va más compacto que la placa que había antes: cada
     pixel de alto acá obliga a dos de burbuja (ver la cuenta de arriba),
     y con los tamaños originales la sección no entraba en una pantalla. */
  .ct-form {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .ct-form .grid {
    gap: 0.7rem;
  }
  .ct-form .plate-field {
    margin-top: 0.3rem;
    padding: 0.5rem 0.8rem;
  }
  .ct-form textarea.plate-field {
    min-height: 0;
  }
  .ct-form .btn {
    padding: 0.6rem 1.1rem;
  }

  @media (max-width: 1023px) {
    /* Apilada, la columna es más angosta que la burbuja que necesita el
       formulario: el escenario se pasa mucho más hacia los dos lados. */
    .ct-stage {
      width: calc(100% + 24vw);
      margin-inline: -12vw;
      padding: 52% 19%;
    }

    /* Los pares de campos no se apilan ni en el teléfono: un formulario de
       una sola columna se alarga tanto que la burbuja que tiene que
       contenerlo se vuelve un globo de dos pantallas de alto. */
    .ct-form .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 641px) and (max-width: 1023px) {
    /* A esta altura el formulario ya entra más ancho, así que necesita
       menos alto y el escenario se pasa menos. */
    .ct-stage {
      width: calc(100% + 16vw);
      margin-inline: -8vw;
      padding: 32% 19%;
    }
  }
</style>

<script>
  import { initContactBlob } from "../scripts/contactBlob";

  const stage = document.querySelector<HTMLElement>(".ct-stage");
  if (stage) initContactBlob(stage);
</script>
