---
import { brands } from "../data/brands";

// Secuencia de frames (WebP con alpha, fondo verde ya quitado con ffmpeg
// colorkey) de la caja Etman abriéndose y los repuestos saliendo. Generada a
// partir de public/videos/box_products_greengb.mp4 — ver frame-001..080 en
// public/images/box-sequence/.
const BOX_FRAME_COUNT = 80;
---

<section id="productos" class="py-20 md:py-28 bg-brand-600">
  <div class="container-x relative z-10">
    {/* Bloque scrub: .box-scrub-space sólo aporta alto de scroll (ver
        box-scrub CSS más abajo); adentro, .box-scrub-wrap es "sticky" y se
        queda pegado bajo el header mientras dura ese alto. El título y el
        párrafo van DENTRO del wrap (no hay una copia afuera): así se ven,
        una sola vez, todo el tiempo junto con la caja abriéndose y el
        carrusel de marcas, debajo del canvas. */}
    <div class="box-scrub-space" id="box-scrub-space" data-frame-count={BOX_FRAME_COUNT}>
      {/* wrap es flex-column con justify-content: space-between (ver
          global.css): título pegado arriba, carrusel pegado abajo, y el
          canvas queda centrado a mitad de camino entre los dos porque el
          espacio libre se reparte por igual antes y después de él. */}
      <div class="box-scrub-wrap" id="box-scrub-wrap">
        <div class="box-scrub-intro max-w-2xl mx-auto text-center">
          <span class="eyebrow">Productos</span>
          <h2 class="section-title box-scrub-title mt-2">
            El portafolio más amplio del mercado.
          </h2>
          <p class="lead box-scrub-lead mt-2 mx-auto">
            Marcas líderes, soluciones probadas y nuevas líneas para
            acompañar la evolución de la movilidad. Todo el catálogo,
            listo para salir de la caja.
          </p>
        </div>

        {/* Brillo detrás de la caja: un halo radial centrado en el canvas,
            no en el video (el frame en sí no tiene canal para "agregar" luz
            sin re-procesar las 80 secuencias) — así funciona a cualquier
            tamaño de canvas y no depende de la resolución del asset. */}
        <div class="box-scrub-canvas-wrap">
          <div class="box-scrub-glow" aria-hidden="true"></div>
          <canvas
            id="box-canvas"
            aria-hidden="true"
            class="box-canvas"
            width={960}
            height={540}
          ></canvas>
        </div>

        {/* Marquee de marcas (logos). Van sobre una tira clara propia: varios
            logos vienen con fondo blanco "horneado" en el PNG, así que
            mostrarlos directo sobre el fondo de marca quedaría inconsistente.
            La tira no lleva borde ni radio: se desvanece a los costados junto
            con los logos (ver .brand-strip en global.css). */}
        <div class="box-scrub-marquee">
          <div class="text-center text-xs uppercase tracking-widest text-white/60 font-semibold">
            Algunas de las marcas que comercializamos
          </div>
          <div class="brand-strip mt-6">
            <div class="marquee">
              <div class="marquee-track gap-14 py-3 items-center">
                {
                  [...brands, ...brands].map((b) =>
                    b.logo ? (
                      <img
                        src={b.logo}
                        alt={b.name}
                        title={b.name}
                        loading="lazy"
                        decoding="async"
                        class={`shrink-0 w-auto object-contain select-none cursor-pointer transition-transform duration-300 ease-out hover:scale-[1.08] ${
                          b.wide ? "h-8 md:h-10" : "h-16 md:h-20"
                        }`}
                      />
                    ) : (
                      <span
                        title={b.name}
                        class="shrink-0 h-16 md:h-20 flex items-center justify-center px-3 font-display font-extrabold tracking-tighter2 text-ink-800 text-2xl md:text-3xl select-none cursor-pointer transition-transform duration-300 ease-out hover:scale-[1.08]"
                      >
                        {b.name}
                      </span>
                    )
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initBoxScrub } from "../scripts/boxScrub";

  const space = document.getElementById("box-scrub-space")!;
  const frameCount = Number(space.dataset.frameCount);

  initBoxScrub({
    space,
    wrap: document.getElementById("box-scrub-wrap")!,
    canvas: document.getElementById("box-canvas") as HTMLCanvasElement,
    frameCount,
    framePath: (i) =>
      `/images/box-sequence/frame-${String(i + 1).padStart(3, "0")}.webp`,
  });
</script>
