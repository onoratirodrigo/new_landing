---
// Envoltorio para la franja continua Nosotros → Contacto: agrega una grilla
// de puntitos blancos de fondo (por detrás del contenido de cada sección,
// que ya vive en su propio z-index) que "brillan" cerca del mouse y
// parpadean sutilmente solos. La densidad de la grilla sigue el mismo
// progreso bordeaux -> magenta que ya maneja Header.astro (no se
// re-implementa ese cálculo acá: en cada tick se lee el valor resuelto de
// --brand-600 y se deduce qué tan "magenta" está ahora mismo).
//
// El dibujo en sí vive en scripts/shimmer.ts porque la intro del estarcido
// usa la misma grilla; acá sólo se le dice qué región seguir.
//
// Importante: este div NO puede llevar "position: relative" (ni cualquier
// otra que lo convierta en offsetParent). El canvas es "fixed", no lo
// necesita para posicionarse; y Header.astro mide nosotrosEl.offsetTop /
// etmanMarketEl.offsetTop asumiendo que su offsetParent sigue siendo
// <body>. Agregar posicionamiento acá rompe (en silencio) el arranque del
// degradé de scroll bordeaux -> magenta.
---

<div id="shimmer-region">
  <canvas id="shimmer-canvas" aria-hidden="true"></canvas>
  <slot />
</div>

<style>
  #shimmer-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import { createShimmer } from "../scripts/shimmer";

  const region = document.getElementById("shimmer-region");
  const canvas = document.getElementById("shimmer-canvas") as HTMLCanvasElement | null;

  if (region && canvas) {
    createShimmer({
      canvas,
      // Los puntos acompañan a la franja Nosotros → Contacto: fuera de ella
      // getRegion devuelve el rect igual y el módulo se encarga de no dibujar
      // cuando queda fuera de pantalla.
      getRegion: () => {
        const rect = region.getBoundingClientRect();
        return { top: rect.top, height: rect.height };
      },
    });
  }
</script>
