# Copiá este archivo a ".env" y completá los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# Conexión a la base de datos MySQL (vía túnel SSH en desarrollo local).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Clave secreta para firmar las cookies de sesión (HMAC-SHA256).
# Generar una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Túnel SSH hacia la base de datos (usado por scripts/dev.mjs).
# DB_TUNNEL_REMOTE: host:puerto de la base de datos vista desde el servidor SSH.
# DB_TUNNEL_SSH_HOST: alias definido en tu ~/.ssh/config (Host + HostName + User + IdentityFile).
DB_TUNNEL_REMOTE=
DB_TUNNEL_SSH_HOST=
